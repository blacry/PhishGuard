# PhishGuard — Python .gitignore

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
htmlcov/
.coverage

# Distribution
dist/
build/
*.egg-info/

# Docker local overrides
.env

# Local scan database and SQLite journal files
data/scan_history.sqlite3*
data/openphish_cache.json

# Keyword and benchmark CSV files are tracked project data
